{
  "name": "karate-tournament",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev:electron": "set BUILD_TARGET=electron&& next build && electron .",
    "build:electron": "set BUILD_TARGET=electron&& next build && electron-builder",
    "dev": "next dev",
    "server:local": "node server-local.js",
    "build:server": "node scripts/build-server.mjs",
    "build": "next build",
    "build:gh": "node build-gh.js",
    "build:hostinger": "node build-hostinger.js",
    "check:hostinger": "node check-hostinger-deployment.js",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "deploy": "node deploy-both.js",
    "build:hostinger:static": "node build-hostinger-static.js"
  },
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "localforage": "^1.10.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.karatetech.app",
    "productName": "KarateTech 2.0",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "public/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
